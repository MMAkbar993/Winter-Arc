# Copy to .env.local and fill in. Never commit real keys.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_…). Safe in the browser: RLS limits it to the signed-in user's rows.
# The legacy name NEXT_PUBLIC_SUPABASE_ANON_KEY (an eyJ… anon key) also works.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only secret. Used ONLY by the development seed script (npm run seed).
# The app itself never reads it. Do not add it to Vercel unless you know why.
SUPABASE_SERVICE_ROLE_KEY=

# Public URL of the app, used in auth email links (sign-up confirmation, password reset).
# Local: http://localhost:3000 · Production: https://your-domain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000
